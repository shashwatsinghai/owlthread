{
  "manifest_version": 3,
  "name": "OwlThread",
  "version": "1.6.0",
  "minimum_chrome_version": "110",
  "description": "Your floating owl companion. Save current pages and complete new AI turns to local memory.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hotstar.com/*",
        "*://*.hulu.com/*",
        "*://*.twitch.tv/*",
        "*://*.spotify.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.snapchat.com/*",
        "*://*.pinterest.com/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.kick.com/*",
        "*://*.soundcloud.com/*",
        "*://*.discord.com/*"
      ],
      "js": [
        "policy.js",
        "content.js",
        "companion.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/owl-cozy-developer.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OwlThread"
  },
  "commands": {
    "capture_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+O"
      },
      "description": "Capture the current page or current AI turn"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
